{
  "_note": "build_pack.py が取得対象にする空港など。秘密情報（ID・パスワード）は絶対に書かないこと。",
  "airport_set": "japan_all",
  "default_airports": [
    "RJTT",
    "RJFF"
  ],
  "extra_airports": [],
  "sync_repo": "falchawk/flight-buddy",
  "public_repo": true,
  "keep_packs": 3,
  "timezone_offset_hours": 9,
  "airport_static": {
    "RJTT": {
      "operatingHours": "24H"
    },
    "RJFF": {
      "operatingHours": "0700-2200 JST（目安・要確認）"
    }
  },
  "include_restricted": true,
  "_restricted_note": "MetAir図はユーザーがMetAirから個別に利用許可を得たため既定で含める（2026-11-18）。許可が無くなったら false に戻すこと。"
}
